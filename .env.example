APP_NAME=FOSER
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://foser.example.com

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info
LOG_DAILY_DAYS=14

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=foser
DB_USERNAME=foser
DB_PASSWORD=replace-with-a-long-random-secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_DEFAULT_REGION=us-east-1
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_USE_PATH_STYLE_ENDPOINT=true

CACHE_STORE=redis
CACHE_PREFIX=foser-prod-
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=replace-with-a-long-random-secret
REDIS_PORT=6379

SANCTUM_STATEFUL_DOMAINS=foser.example.com
CORS_ALLOWED_ORIGINS=https://foser.example.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
TLS_CERT_DIR=/etc/letsencrypt/live/foser.example.com
APP_VERSION=latest

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.example.com
MAIL_PORT=2525
MAIL_USERNAME=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-secret
MAIL_FROM_ADDRESS="no-reply@foser.example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

BACKUP_DIR=./backups
BACKUP_ENCRYPTION_KEY=replace-with-a-long-random-secret
BACKUP_RETENTION_DAYS=14
BACKUP_S3_BUCKET=

VITE_APP_NAME="${APP_NAME}"
